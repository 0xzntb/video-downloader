{
  "manifest_version": 3,
  "name": "Viddl — send videos to my terminal",
  "version": "1.0.0",
  "description": "Adds a download button to YouTube and a right-click option everywhere else. Hands the link to the Viddl app on your computer — no server, no account.",
  "author": "Viddl",
  "permissions": ["contextMenus", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-youtube.js"],
      "css": ["content-youtube.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send this page to Viddl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
